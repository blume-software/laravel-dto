{
    "name": "blume/laravel-dto",
    "description": "Laravel DTO library with validation attributes, casts, response helpers, and OpenAPI generation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "nesbot/carbon": "^3.0",
        "phpdocumentor/reflection-docblock": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Blume\\LaravelDTO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blume\\LaravelDTO\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blume\\LaravelDTO\\LaravelDTOServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
